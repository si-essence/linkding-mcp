# Copy to .env (git-ignored) or set these in your MCP client config.

# Linkding origin. No userinfo, query, or hash.
LINKDING_URL=http://127.0.0.1:9090

# API token from Linkding Settings > Integrations. Sent as "Authorization: Token <token>". Never printed.
LINKDING_API_TOKEN=

# The literal "true" enables writes. Anything else keeps the connector read-only.
LINKDING_ALLOW_WRITES=false

# Contact embedded in the User-Agent. Use an address you control. Must not contain the token.
LINKDING_CONTACT=you@example.com

# Local sliding-window cap per minute. Cache hits do not spend it.
LINKDING_PER_MINUTE=30

# Upstream timeout in milliseconds.
LINKDING_TIMEOUT_MS=20000

# Cache TTL in seconds for successful reads. 0 disables caching.
LINKDING_CACHE_TTL_SEC=60

# stdio (default) or http. --http on the command line forces http.
# HTTP listens on localhost and has no authentication.
MCP_TRANSPORT=stdio
PORT=3000
